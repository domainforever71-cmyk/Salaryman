SECRET_KEY=change-me-to-a-long-random-string      # must be IDENTICAL on every server
DATABASE_URL=postgresql://user:pass@host/db        # must be the SAME database on every server

# Operators who are admins no matter how they capitalise their name
ADMIN_USERNAMES=alex,domain

# --- Multiple servers (optional). Same list on every server. ---
# format: id|Display name|https://url , ...
ASTRA_SERVERS=eu|Europe|https://eu.example.com,us|N. America|https://us.example.com
# Which one THIS deployment is (different on each server):
ASTRA_SERVER_ID=eu

# Optional: seconds the syndicate endpoint may hold a request open (0 = never; recommended)
COOP_POLL_TIMEOUT=0

# Anti-tamper: where your PRIVATE signing key lives (default ~/.astra_release/astra_private.key). Never deploy it.
# ASTRA_SIGNING_KEY=
